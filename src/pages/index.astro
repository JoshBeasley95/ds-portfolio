---
import BaseLayout from '../layouts/BaseLayout.astro';
// Deliberately does NOT enumerate the generated case studies — this site is an unlisted
// host. Each study is reached only via its direct link (application Website field / LinkedIn).
// The curated personal-brand site lives elsewhere.
---
<BaseLayout title="Joshua Beasley">
  <section class="hero">
    <h1>Joshua Beasley</h1>
    <p class="tagline">Applied data-science case studies.</p>
    <p>
      This is a working space for hands-on, end-to-end data-science case studies — each a
      runnable demonstration (EDA → model → evaluation → explainability) built on public or
      synthetic data. The code for every study lives on GitHub.
    </p>
    <div class="hero-links">
      <a class="btn" href="https://github.com/JoshBeasley95/ds-portfolio" target="_blank" rel="noopener">Code on GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/joshuabeasley/" target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href="mailto:texasjmb@gmail.com">Email</a>
    </div>
  </section>
</BaseLayout>
